  {
    "id": "03",
    "title": "Das ist meine Familie",
    "subtitle": "Familia y posesivos",
    "explain": "Para presentar familiares: «Das ist mein Vater» o «Das ist meine Mutter». En nominativo, «mein» se usa con sustantivos masculinos y neutros; «meine», con femeninos y plurales.",
    "examples": [
      "Das ist mein Bruder.",
      "Das ist meine Schwester.",
      "Meine Eltern wohnen in Berlin."
    ],
    "questions": [
      {
        "q": "Completa: Das ist ___ Mutter.",
        "a": [
          "mein",
          "meine",
          "meinen"
        ],
        "correct": 1,
        "why": "«Mutter» es femenino: «meine Mutter»."
      },
      {
        "q": "¿Qué significa «der Bruder»?",
        "a": [
          "El padre",
          "El hermano",
          "El abuelo"
        ],
        "correct": 1,
        "why": "«der Bruder» significa «el hermano»."
      },
      {
        "q": "Completa: ___ Vater ist Lehrer.",
        "a": [
          "Mein",
          "Meine",
          "Meinen"
        ],
        "correct": 0,
        "why": "«Vater» es masculino nominativo: «mein Vater»."
      }
    ]
  },
  {
