        "correct": 0,
        "why": "Se dice der Tisch."
      },
      {
        "q": "Completa: ___ Lampe ist neu.",
        "a": [
          "Der",
          "Die",
          "Das"
        ],
        "correct": 1,
        "why": "Lampe es femenino: die Lampe."
      },
      {
        "q": "¿Cómo preguntas cuánto cuesta algo?",
        "a": [
          "Wie alt bist du?",
          "Wie viel kostet das?",
          "Woher kommst du?"
        ],
        "correct": 1,
        "why": "Wie viel kostet das? significa ¿Cuánto cuesta eso?"
      },
      {
        "q": "«Das Sofa ist teuer» significa…",
        "a": [
          "El sofá es caro",
          "El sofá es pequeño",
          "El sofá es nuevo"
        ],
        "correct": 0,
        "why": "teuer = caro."
      }
    ]
  },
