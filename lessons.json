        "why": "Termin es masculino y objeto directo: einen Termin."
      },
      {
        "q": "Completa: Wir kaufen ___ Laptop.",
        "a": [
          "einen",
          "eine",
          "ein"
        ],
        "correct": 0,
        "why": "Laptop suele ser masculino: einen Laptop."
      },
      {
        "q": "Completa: Sie hat ___ Tastatur.",
        "a": [
          "ein",
          "eine",
          "einen"
