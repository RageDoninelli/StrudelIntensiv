      "Ich komme aus Guatemala.",
      "Woher kommst du?",
      "Ich spreche Spanisch und ein bisschen Deutsch."
    ],
    "questions": [
      {
        "q": "Completa: Ich ___ aus Guatemala.",
        "a": [
          "kommst",
          "komme",
          "kommt"
        ],
        "correct": 1,
        "why": "Con «ich», la forma es «komme»."
      },
      {
        "q": "¿Qué significa «Woher kommst du?»?",
        "a": [
          "¿De dónde eres?",
          "¿Dónde vives?",
          "¿Cómo te llamas?"
        ],
        "correct": 0,
        "why": "«Woher» pregunta por el origen."
      },
      {
        "q": "Completa: Sie ___ Deutsch. (ella)",
        "a": [
          "spreche",
          "sprichst",
          "spricht"
        ],
        "correct": 2,
        "why": "«sprechen» cambia la vocal con «er/sie/es»: spricht."
      }
    ]
