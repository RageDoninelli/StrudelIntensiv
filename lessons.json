  {
    "id": "01",
    "title": "Hallo! Ich bin …",
    "subtitle": "Saludos y presentaciones",
    "explain": "Para presentarte, usa «Ich heiße …» (me llamo…) o «Ich bin …» (soy…). Para preguntar el nombre: «Wie heißt du?» (informal) y «Wie heißen Sie?» (formal).",
    "examples": [
      "Hallo! Ich heiße Anna.",
      "Wie heißt du? – Ich heiße Luis.",
      "Guten Morgen! Wie heißen Sie?"
    ],
    "questions": [
      {
        "q": "¿Cómo dices «Me llamo Ana»?",
        "a": [
          "Ich heiße Ana.",
          "Du heißt Ana.",
          "Ich komme Ana."
        ],
        "correct": 0,
        "why": "«Ich heiße» significa «me llamo»."
      },
      {
        "q": "¿Cuál es la pregunta informal «¿Cómo te llamas?»?",
        "a": [
          "Wo wohnst du?",
          "Wie heißt du?",
          "Wie alt bist du?"
        ],
        "correct": 1,
        "why": "«Wie heißt du?» pregunta el nombre de alguien de confianza."
      },
      {
        "q": "¿Cuál es un saludo de mañana?",
        "a": [
          "Gute Nacht!",
          "Tschüss!",
          "Guten Morgen!"
        ],
        "correct": 2,
        "why": "«Guten Morgen!» significa «Buenos días» por la mañana."
      }
    ]
  },
  {
    "id": "02",
    "title": "Woher kommst du?",
    "subtitle": "Países e idiomas",
    "explain": "«Ich komme aus Guatemala» indica procedencia. «Ich spreche Spanisch» expresa qué idioma hablas. El verbo «kommen» cambia: ich komme, du kommst, er/sie kommt.",
